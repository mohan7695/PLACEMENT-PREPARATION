import java.util.*;

public class Main {
    public static void main(String[] args) {
        Scanner sc = new Scanner(System.in);
        
        if (!sc.hasNextLine()) return;
        // Removes "A =", spaces, and any double quotes
        String a = sc.nextLine().replaceAll("A\\s*=\\s*|\"", "").trim();
        
        if (!sc.hasNextLine()) return;
        // Removes "B =", spaces, and any double quotes
        String b = sc.nextLine().replaceAll("B\\s*=\\s*|\"", "").trim();
        
        System.out.println(rotationCheck(a, b));
    }

    public static int rotationCheck(String a, String b) {
        if (a.length() != b.length() || a.isEmpty()) {
            return 0;
        }
        
        String combined = a + a;
        return combined.contains(b) ? 1 : 0;
    }
}
