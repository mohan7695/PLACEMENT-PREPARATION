import java.util.*;
public class Main{
  public static void main(String[] args){
    Scanner sc = new Scanner(System.in);
 String  s  = sc.nextLine();
 
 s = s.replace("A =","").trim();
 int n =Integer.parseInt(s);
    
    System.out.println(Scan(n));
  }
  public static int Scan(int n){
    if( n == 1){
      return 0;
    }
    int count =0;
    while( n != 1){
      if((n&1) == 0){
        n/=2;
      }else{
        n = 3*n+1;
      }
      count++;
    }
    return count;
  }
}
