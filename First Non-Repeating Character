import java.util.*;

public class Main {
    public static void main(String[] args) {
        Scanner sc = new Scanner(System.in);
        
        // Read input and clean up potential prefix formatting
        String s = sc.nextLine();
        s = s.replace("S = ", "").trim();
        
       String result = nonRepeat(s);
    
    // If a valid character is found, wrap it in double quotes
    if (!result.equals("-1")) {
        System.out.println("\"" + result + "\"");
    } else {
        System.out.println(result);
    }
    }

    public static String nonRepeat(String s) {
        // Frequency array for ASCII characters
        int[] counts = new int[256];
        
        // First pass: Count occurrences of each character
        for (int i = 0; i < s.length(); i++) {
            counts[s.charAt(i)]++;
        }
        
        // Second pass: Find the first character with a count of 1
        for (int i = 0; i < s.length(); i++) {
            char ch = s.charAt(i);
            if (counts[ch] == 1) {
                return String.valueOf(ch);
            }
        }
        
        // Return "-1" if all characters repeat
        return "-1";
    }
}
