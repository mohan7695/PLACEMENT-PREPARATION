import java.util.*;
public class Main{
  static void factors(int n){
    
    ArrayList<Integer> list=new ArrayList<>();
    
    int i=1;
    
    while(i <= n){
      
      if(n%i==0){
        list.add(i);
      }
      i++;
    }
    

      System.out.println(list);
     
    
    
  }
  public static void main(String[] args){
    Scanner sc=new Scanner(System.in);
    
    String k=sc.nextLine();
    k=k.replace("A =","").trim();
    
    int n=Integer.parseInt(k);
    factors(n);
  }
}
