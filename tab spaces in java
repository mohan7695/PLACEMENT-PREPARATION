import java.util.*;

public class Main {
    public static void main(String[] args) {
        Scanner sc = new Scanner(System.in);
        if (!sc.hasNextLine()) return;
        String s = sc.nextLine();

        // 1. Remove the prefix "S=" or "S = " if present
        s = s.replace("S=", "").replace("S = ", "");

        // 2. Remove enclosing double quotes if they exist
        if (s.startsWith("\"") && s.endsWith("\"")) {
            s = s.substring(1, s.length() - 1);
        }

        // 3. Rebuild the string without spaces or literal/escaped tabs
        StringBuilder sb = new StringBuilder();
        for (int i = 0; i < s.length(); i++) {
            char ch = s.charAt(i);

            // Checks for actual tab or escaped tab sequence '\t'
            if (ch == ' ' || ch == '\t') {
                continue;
            }
            if (ch == '\\' && i + 1 < s.length() && s.charAt(i + 1) == 't') {
                i++; // Skip the 't'
                continue;
            }

            sb.append(ch);
        }

        // 4. Print the final result wrapped in quotes to match your Expected Output
        System.out.println("\"" + sb.toString() + "\"");
    }
}
