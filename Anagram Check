import java.util.*;
public class Main{
  public static void main(String[] args){
    Scanner sc=new Scanner(System.in);
    
    String s=sc.nextLine();
    
    s=s.replace("A = ","").trim();
    
    String s1=sc.nextLine();
    s1=s1.replace("B = ","").trim();
    
    System.out.println(anagramCheck(s,s1));
  }
  public static int anagramCheck(String s,String s1){
      s = s.toLowerCase().replaceAll("[^a-z]", "");
        s1 = s1.toLowerCase().replaceAll("[^a-z]", "");
    int[] arr=new int[26];
    if(s.length() != s1.length()){
      return 0;
    }
    for(int i=0;i<s.length();i++){
      arr[s.charAt(i)-'a']++;
    }
    for(int i=0;i<s1.length();i++){
      arr[s1.charAt(i)-'a']--;
    }
    for(int l : arr){
      if( l != 0){
        return 0;
      }
    }
    return 1;
  }
}
