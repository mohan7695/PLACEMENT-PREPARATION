import java.util.*;
public class Main{
  public static void main(String[] args){
    Scanner sc=new Scanner(System.in);
    
    String s=sc.nextLine();
    s=s.replace("A =","").trim();
    
    int n=Integer.parseInt(s);
    
    System.out.println(binaryBits(n));
  }
  public static int binaryBits(int n){
    int count=0;
    while(n > 0){
         n=n&(n-1);
         count++;
    }
     return count;
  }
}
